[core]
  editor = bbedit --wait

[user]
  name = Ruben Arakelyan
  email = ruben@arakelyan.uk

[init]
  defaultBranch = main

[gpg]
  program = /usr/local/MacGPG2/bin/gpg

[commit]
  gpgsign = true

[color "status"]
  added = green bold
  changed = red bold strike
  untracked = cyan
  branch = yellow black bold ul

[diff]
  tool = bbedit

[difftool "bbedit"]
  cmd = bbedit --wait --resume "$LOCAL" "$REMOTE"
  trustExitCode = true

[difftool]
  prompt = false

[merge]
  tool = bbedit

[mergetool "bbedit"]
  cmd = bbedit --wait --resume "$LOCAL" "$MERGED" "$REMOTE"
  trustExitCode = true

[mergetool]
  prompt = false
